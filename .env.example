# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Use local: MONGODB_URL=mongodb://localhost:27017/wayloe
# Use Docker: MONGODB_URL=mongodb://mongo:27017/wayloe
MONGODB_URL=mongodb://localhost:27017/wayloe

# JWT
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-at-least-32-characters-long

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_PUBLIC_BUCKET=your-public-bucket-name
AWS_PRIVATE_BUCKET=your-private-bucket-name

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# OpenAI (content moderation for groups)
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
